spring.application.name=cafeteria-system

# MySQL Database Configuration
# Values can be overridden via environment variables: DB_USERNAME and DB_PASSWORD
spring.datasource.url=jdbc:mysql://localhost:3306/cafeteria_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Server Port
server.port=8080
